    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "onnxruntime-node": false
