# GEMINI_API_KEY: Optional fallback key if OpenWebUI is unavailable.
GEMINI_API_KEY=""

# OPENWEBUI_BASE_URL: Base URL for your OpenWebUI instance (e.g. http://host.docker.internal:8080/api)
OPENWEBUI_BASE_URL="http://host.docker.internal:8080/api"

# OPENWEBUI_API_KEY: API key for your local OpenWebUI instance if required
OPENWEBUI_API_KEY=""

# DEFAULT_MODEL: Default LLM model name inside OpenWebUI
DEFAULT_MODEL="llama3"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

